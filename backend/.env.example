# Nukopijuokite į backend/.env ir pakeiskite reikšmes. .env į git nepatenka.
# Kintamųjų vardai – ASP.NET Core konfigūracijos raktai, kur „:“ pakeistas „__“.
# Jau nustatyti aplinkos kintamieji turi pirmenybę prieš šį failą.

ASPNETCORE_ENVIRONMENT=Development

# PostgreSQL (atitinka infrastructure/docker/docker-compose.yml)
ConnectionStrings__Default=Host=localhost;Port=5432;Database=saskaitu_agentas;Username=saskaitu_agentas;Password=saskaitu_agentas

# JWT – bent 32 simboliai. Sugeneruoti:  openssl rand -base64 48
Jwt__SigningKey=change-me-to-a-long-random-secret-at-least-32-chars
Jwt__AccessTokenMinutes=15
Jwt__RefreshTokenDays=30

# Frontend kilmės, atskirtos kableliais
Cors__AllowedOrigins=http://localhost:3000

# Slaptažodžio atkūrimo nuoroda laiške (frontend puslapis)
PasswordReset__ResetUrl=http://localhost:3000/reset-password

# Swagger UI ne Development aplinkoje
Swagger__Enabled=false
